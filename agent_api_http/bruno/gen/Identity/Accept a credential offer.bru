example {
  name: 422 Response
  description: The credential offer cannot be processed, e.g. it carries no pre-authorized code
  
  request: {
    url: {{BASE_URL}}/v0/holder/offers/:offer_id/accept
    method: POST
    mode: none
    params:path: {
      offer_id: 
    }
  }
  
  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 501 Response
  description: The credential issuer requires a flow UniCore does not support yet
  
  request: {
    url: {{BASE_URL}}/v0/holder/offers/:offer_id/accept
    method: POST
    mode: none
    params:path: {
      offer_id: 
    }
  }
  
  response: {
    status: {
      code: 501
      text: Not Implemented
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

