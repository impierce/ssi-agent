meta {
  name: Accept a credential offer
  type: http
  seq: 7
  tags: [
    Identity
    Holder
  ]
}

post {
  url: {{BASE_URL}}/v0/holder/offers/:offer_id/accept
  body: none
  auth: inherit
}

params:path {
  offer_id: {{RECEIVED_OFFER_ID}}
}

docs {
  Accepts a credential offered to your organization by its ID.
}

example {
  name: 201 Response
  description: Credential offer accepted successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/offers/:offer_id/accept
    method: POST
    mode: none
    params:path: {
      offer_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "credential_configurations": "",
          "credential_offer": "",
          "credentials": [
            {
              "credential": "",
              "holder_credential_id": ""
            }
          ],
          "id": "",
          "status": "Pending",
          "token_response": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Credential offer not found
  
  request: {
    url: {{BASE_URL}}/v0/holder/offers/:offer_id/accept
    method: POST
    mode: none
    params:path: {
      offer_id: 
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
