meta {
  name: Store a credential in the organisation's wallet
  type: http
  seq: 4
  tags: [
    Identity
    Holder
  ]
}

post {
  url: {{BASE_URL}}/v0/holder/credentials
  body: json
  auth: inherit
}

body:json {
  {
    "credential": ""
  }
}

docs {
  Imports a compact JWT-encoded verifiable credential into the organisation's holder wallet.
}

example {
  name: 201 Response
  description: Credential stored successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/credentials
    method: POST
    mode: json
    body:json: {
      {
        "credential": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "data": "",
          "id": "",
          "received_offer_id": "",
          "signed": ""
        }
      '''
    }
  }
}
