meta {
  name: Remove linked verifiable presentations
  type: http
  seq: 19
  tags: [
    Identity
  ]
}

post {
  url: {{BASE_URL}}/v0/remove-linked-verifiable-presentations
  body: json
  auth: inherit
}

body:json {
  {
    "presentationIds": []
  }
}

docs {
  Withdraws the given presentations while preserving all others in their existing order. Unknown
  IDs and duplicates are no-ops; removing a holder's last presentation removes its DID service.
}

example {
  name: 204 Response
  description: Presentations withdrawn
  
  request: {
    url: {{BASE_URL}}/v0/remove-linked-verifiable-presentations
    method: POST
    mode: json
    body:json: {
      {
        "presentationIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

