meta {
  name: Update organisation profile
  type: http
  seq: 17
  tags: [
    Identity
    Profile
  ]
}

patch {
  url: {{BASE_URL}}/v0/profile
  body: json
  auth: inherit
}

body:json {
  {
    "country": "",
    "description": "",
    "displayName": "",
    "logo": ""
  }
}

docs {
  Updates your organisation's profile with the given information.
}

