meta {
  name: Verify linked domains
  type: http
  seq: 22
  tags: [
    Identity
  ]
}

get {
  url: {{BASE_URL}}/v0/verify-linked-domains
  body: none
  auth: inherit
}

docs {
  Checks every linked domain the way an external verifier would: resolves each origin's published
  DID configuration over the network and validates it, alongside a freshly resolved `CNAME` lookup
  showing whether the domain points at this deployment.
}

example {
  name: 200 Response
  description: Verification result per linked domain

  request: {
    url: {{BASE_URL}}/v0/verify-linked-domains
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "message": "",
          "origins": [
            {
              "dns": {
                "chain": [],
                "error": "",
                "points_here": false
              },
              "linkage_valid": false,
              "message": "",
              "origin": "https://example.org",
              "valid": false
            }
          ],
          "valid": false
        }
      '''
    }
  }
}

