meta {
  name: List all credentials (GET)
  type: http
  seq: 3
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/credentials
  body: none
  auth: inherit
}

docs {
  Retrieves all credentials held by your organisation.
}

example {
  name: 200 Response
  description: All credentials retrieved successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/credentials
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "data": "",
            "id": "",
            "received_offer_id": "",
            "signed": ""
          }
        ]
      '''
    }
  }
}

script:post-response {
  const items = res.getBody();
  if (Array.isArray(items) && items.length > 0) {
    const lastId = items[items.length - 1]?.id;
    if (lastId) {
      bru.setVar('HOLDER_CREDENTIAL_ID', lastId);
    }
  }
}
