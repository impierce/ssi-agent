meta {
  name: Get credential by ID (GET)
  type: http
  seq: 5
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/credentials/:holder_credential_id
  body: none
  auth: inherit
}

params:path {
  holder_credential_id: {{HOLDER_CREDENTIAL_ID}}
}

docs {
  Retrieves a credential held by your organisation by its ID.
}

example {
  name: 200 Response
  description: Credential retrieved successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/credentials/:holder_credential_id
    method: GET
    mode: none
    params:path: {
      holder_credential_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": "",
          "id": "",
          "received_offer_id": "",
          "signed": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Credential not found
  
  request: {
    url: {{BASE_URL}}/v0/holder/credentials/:holder_credential_id
    method: GET
    mode: none
    params:path: {
      holder_credential_id: 
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
