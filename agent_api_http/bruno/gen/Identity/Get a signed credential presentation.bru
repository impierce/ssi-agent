meta {
  name: Get a signed credential presentation
  type: http
  seq: 15
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/presentations/:presentation_id/signed
  body: none
  auth: inherit
}

params:path {
  @description('Credential presentation ID')
  presentation_id: {{PRESENTATION_ID}}
}

docs {
  Retrieves the compact JWT representation of a stored credential presentation.
}

example {
  name: 200 Response
  description: Signed credential presentation

  request: {
    url: {{BASE_URL}}/v0/holder/presentations/:presentation_id/signed
    method: GET
    mode: none
    params:path: {
      presentation_id:
    }
  }

  response: {
    headers: {
      Content-Type: application/jwt
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

