meta {
  name: Create a new credential presentation
  type: http
  seq: 11
  tags: [
    Identity
    Holder
  ]
}

post {
  url: {{BASE_URL}}/v0/holder/presentations
  body: json
  auth: inherit
}

body:json {
  {
    "credentialIds": []
  }
}

docs {
  Creates and signs a new credential presentation containing the given credentials held by your organisation.
}

example {
  name: 201 Response
  description: Presentation created successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/presentations
    method: POST
    mode: json
    body:json: {
      {
        "credentialIds": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "signed": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Credential not found
  
  request: {
    url: {{BASE_URL}}/v0/holder/presentations
    method: POST
    mode: json
    body:json: {
      {
        "credentialIds": []
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
