meta {
  name: Get credential presentation by ID
  type: http
  seq: 14
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/presentations/:presentation_id
  body: none
  auth: inherit
}

params:path {
  presentation_id: {{PRESENTATION_ID}}
}

docs {
  Retrieves a single credential presentation held by your organisation by its ID.
}

example {
  name: 200 Response
  description: Presentation retrieved successfully

  request: {
    url: {{BASE_URL}}/v0/holder/presentations/:presentation_id
    method: GET
    mode: none
    params:path: {
      presentation_id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "signed": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid path parameter

  request: {
    url: {{BASE_URL}}/v0/holder/presentations/:presentation_id
    method: GET
    mode: none
    params:path: {
      presentation_id:
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Presentation not found

  request: {
    url: {{BASE_URL}}/v0/holder/presentations/:presentation_id
    method: GET
    mode: none
    params:path: {
      presentation_id:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
