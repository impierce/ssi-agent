meta {
  name: Unlink domains
  type: http
  seq: 18
  tags: [
    Identity
  ]
}

post {
  url: {{BASE_URL}}/v0/remove-linked-domains
  body: json
  auth: inherit
}

body:json {
  {
    "origins": [
      "example.org",
      "https://foo.example.org"
    ]
  }
}

docs {
  Withdraws the Domain Linkage Credentials for each given origin. Unlinking an origin that is not
  linked is a no-op, and unlinking the last remaining origin removes the service entirely.
}

example {
  name: 204 Response
  description: Domains unlinked

  request: {
    url: {{BASE_URL}}/v0/remove-linked-domains
    method: POST
    mode: json
    body:json: {
      {
        "origins": [
          "example.org",
          "https://foo.example.org"
        ]
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

