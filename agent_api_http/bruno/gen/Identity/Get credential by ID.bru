meta {
  name: Get credential by ID
  type: http
  seq: 7
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/credentials/:credential_id
  body: none
  auth: inherit
}

params:path {
  credential_id: {{HOLDER_CREDENTIAL_ID}}
}

docs {
  Retrieves a credential held by your organisation by its ID.
}

example {
  name: 200 Response
  description: Credential retrieved successfully

  request: {
    url: {{BASE_URL}}/v0/holder/credentials/:credential_id
    method: GET
    mode: none
    params:path: {
      credential_id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": "",
          "id": "",
          "received_offer_id": "",
          "signed": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid path parameter

  request: {
    url: {{BASE_URL}}/v0/holder/credentials/:credential_id
    method: GET
    mode: none
    params:path: {
      credential_id:
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Credential not found

  request: {
    url: {{BASE_URL}}/v0/holder/credentials/:credential_id
    method: GET
    mode: none
    params:path: {
      credential_id:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
