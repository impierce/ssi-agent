meta {
  name: List all credential presentations
  type: http
  seq: 10
  tags: [
    Identity
    Holder
  ]
}

get {
  url: {{BASE_URL}}/v0/holder/presentations
  body: none
  auth: inherit
}

docs {
  Retrieves all credential presentations held by your organisation.
}

example {
  name: 200 Response
  description: All presentations retrieved successfully
  
  request: {
    url: {{BASE_URL}}/v0/holder/presentations
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "id": "",
            "signed": ""
          }
        ]
      '''
    }
  }
}

script:post-response {
  const items = res.getBody();
  if (Array.isArray(items) && items.length > 0) {
    const lastId = items[items.length - 1]?.id;
    if (lastId) {
      bru.setVar('PRESENTATION_ID', lastId);
    }
  }
}
