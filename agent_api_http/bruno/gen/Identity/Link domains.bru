meta {
  name: Link domains
  type: http
  seq: 1
  tags: [
    Identity
  ]
}

post {
  url: {{BASE_URL}}/v0/add-linked-domains
  body: json
  auth: inherit
}

body:json {
  {
    "origins": [
      "example.org",
      "https://foo.example.org"
    ]
  }
}

docs {
  Publishes a Domain Linkage Credential for each given origin, in addition to any already linked.
  Linking an origin that is already linked is a no-op.
}

example {
  name: 204 Response
  description: Domains linked

  request: {
    url: {{BASE_URL}}/v0/add-linked-domains
    method: POST
    mode: json
    body:json: {
      {
        "origins": [
          "example.org",
          "https://foo.example.org"
        ]
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

