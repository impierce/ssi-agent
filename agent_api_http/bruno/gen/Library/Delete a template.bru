post {
  url: {{BASE_URL}}/v0/delete-template
  body: json
  auth: inherit
}

body:json {
  {
    "id": ""
  }
}

docs {
  Deletes a template by marking its status as `Deleted`. Deleted templates will no longer appear in any views.
}

