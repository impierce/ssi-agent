meta {
  name: Create a new catalog
  type: http
  seq: 3
  tags: [
    Library
    Catalog
  ]
}

post {
  url: {{BASE_URL}}/v0/create-new-catalog
  body: json
  auth: inherit
}

body:json {
  {
    "display": "",
    "visibility": ""
  }
}

docs {
  Creates a new catalog with the provided display information.
}

example {
  name: 201 Response
  description: Catalog created successfully
  
  request: {
    url: {{BASE_URL}}/v0/create-new-catalog
    method: POST
    mode: json
    body:json: {
      {
        "display": "",
        "visibility": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "display": {
            "description": "",
            "icon": "",
            "name": ""
          },
          "id": "",
          "modified_at": "",
          "template_ids": [],
          "visibility": "Public"
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Malformed JSON request body, or an empty catalog name
  
  request: {
    url: {{BASE_URL}}/v0/create-new-catalog
    method: POST
    mode: json
    body:json: {
      {
        "display": "",
        "visibility": ""
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: Request body does not match the expected schema
  
  request: {
    url: {{BASE_URL}}/v0/create-new-catalog
    method: POST
    mode: json
    body:json: {
      {
        "display": "",
        "visibility": ""
      }
    }
  }
  
  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
