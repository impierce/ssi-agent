meta {
  name: Get the public sponsoring configuration
  type: http
  seq: 1
  tags: [
    Public
  ]
}

get {
  url: {{BASE_URL}}/public/sponsoring-configuration
  body: none
  auth: inherit
}

docs {
  Returns the public display name, optional logo, and IOTA address used by sponsored identities.
}

example {
  name: 200 Response
  description: Sponsoring configuration retrieved successfully
  
  request: {
    url: {{BASE_URL}}/public/sponsoring-configuration
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "iota_address": "",
          "logo_uri": "",
          "name": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: No sponsoring IOTA address is configured
  
  request: {
    url: {{BASE_URL}}/public/sponsoring-configuration
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
