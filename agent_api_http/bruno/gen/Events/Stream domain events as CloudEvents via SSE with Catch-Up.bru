  request: {
    url: {{BASE_URL}}/v0/events
    method: GET
    mode: none
    params:query: {
      ~types: 
      ~sources: 
      ~subject: 
      ~limit: 0
      ~since: 
      ~until: 
    }
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
