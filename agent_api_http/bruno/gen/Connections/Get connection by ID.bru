meta {
  name: Get connection by ID
  type: http
  seq: 6
  tags: [
    Connections
  ]
}

get {
  url: {{BASE_URL}}/v0/connections/:connection_id
  body: none
  auth: inherit
}

params:path {
  connection_id: {{CONNECTION_ID}}
}

docs {
  Retrieve a specific connection by its unique identifier.
}

