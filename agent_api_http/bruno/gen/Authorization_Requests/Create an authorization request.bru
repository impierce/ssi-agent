meta {
  name: Create an authorization request
  type: http
  seq: 2
  tags: [
    Authorization_Requests
  ]
}

post {
  url: {{BASE_URL}}/v0/authorization_requests
  body: json
  auth: inherit
}

body:json {
  {
    "dcql_query": "",
    "state": ""
  }
}

docs {
  Creates and signs an OpenID authorization request. The returned form-encoded deep link can be opened by a wallet.
}

example {
  name: 201 Response
  description: Authorization request created

  request: {
    url: {{BASE_URL}}/v0/authorization_requests
    method: POST
    mode: json
    body:json: {
      {
        "dcql_query": "",
        "state": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/x-www-form-urlencoded
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 400 Response
  description: Malformed JSON request body

  request: {
    url: {{BASE_URL}}/v0/authorization_requests
    method: POST
    mode: json
    body:json: {
      {
        "dcql_query": "",
        "state": ""
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 422 Response
  description: Request body does not match the expected schema

  request: {
    url: {{BASE_URL}}/v0/authorization_requests
    method: POST
    mode: json
    body:json: {
      {
        "dcql_query": "",
        "state": ""
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
