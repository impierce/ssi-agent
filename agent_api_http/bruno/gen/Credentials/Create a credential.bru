meta {
  name: Create a credential
  type: http
  seq: 1
  tags: [
    Credentials
    Issuance
  ]
}

post {
  url: {{BASE_URL}}/v0/credentials
  body: json
  auth: inherit
}

body:json {
  {
    "credential": "",
    "expiresAt": "",
    "isSigned": false,
    "offerId": "",
    "templateId": ""
  }
}

docs {
  Creates a verifiable credential based on the provided template and data. An offer is created for the provided offer ID.
}

example {
  name: 201 Response
  description: Credential created successfully
  
  request: {
    url: {{BASE_URL}}/v0/credentials
    method: POST
    mode: json
    body:json: {
      {
        "credential": "",
        "expiresAt": "",
        "isSigned": false,
        "offerId": "",
        "templateId": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

script:post-response {
  const location = res.getHeader('location');
  if (location) {
    bru.setVar('CREDENTIAL_LOCATION', location);
  }
}
