}

docs {
  Lists all credentials including their current status and metadata.
}

example {
  name: 200 Response
  description: List of all credentials
  
  request: {
    url: {{BASE_URL}}/v0/credentials
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
