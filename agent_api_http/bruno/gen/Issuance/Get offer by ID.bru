meta {
  name: Get offer by ID
  type: http
  seq: 11
  tags: [
    Issuance
  ]
}

get {
  url: {{BASE_URL}}/v0/offers/:offer_id
  body: none
  auth: inherit
}

params:path {
  offer_id: 
}

docs {
  Retrieves a credential offer by its ID.
}

