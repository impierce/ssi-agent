meta {
  name: Create a credential offer
  type: http
  seq: 8
  tags: [
    Issuance
  ]
}

post {
  url: {{BASE_URL}}/v0/offers
  body: json
  auth: inherit
}

body:json {
  {
    "offerId": "c86289fa-b105-4ec3-9326-a02436788f11",
    "templateIds": [
      "w3c_vc_credential"
    ]
  }
}

docs {
  Creates and returns an OpenID4VCI credential offer advertising the credential configurations
  derived from one or more published templates. `templateIds` is required because an offer must
  tell the wallet which credential types it may request. It does not create credential instances
  or contain their claim data; credentials may be attached beforehand or supplied just in time
  after the wallet starts the issuance flow.
  
  If an offer with the given `offerId` already exists, the existing encoded offer is returned
  unchanged.
}

example {
  name: 200 Response
  description: Credential offer created successfully
  
  request: {
    url: {{BASE_URL}}/v0/offers
    method: POST
    mode: json
    body:json: {
      {
        "offerId": "c86289fa-b105-4ec3-9326-a02436788f11",
        "templateIds": [
          "w3c_vc_credential"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/x-www-form-urlencoded
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Template IDs are missing or invalid
  
  request: {
    url: {{BASE_URL}}/v0/offers
    method: POST
    mode: json
    body:json: {
      {
        "offerId": "c86289fa-b105-4ec3-9326-a02436788f11",
        "templateIds": [
          "w3c_vc_credential"
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: A template was not found or is not published
  
  request: {
    url: {{BASE_URL}}/v0/offers
    method: POST
    mode: json
    body:json: {
      {
        "offerId": "c86289fa-b105-4ec3-9326-a02436788f11",
        "templateIds": [
          "w3c_vc_credential"
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

script:post-response {
  const raw = res.getBody();
  const decoded = decodeURIComponent(typeof raw === 'string' ? raw : String(raw));
  const [, value] = decoded.split('=', 2);
  if (value) {
    bru.setVar('CREDENTIAL_OFFER_URI', value);
  }
}
