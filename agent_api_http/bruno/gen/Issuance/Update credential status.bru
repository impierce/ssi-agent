meta {
  name: Update credential status
  type: http
  seq: 4
  tags: [
    Issuance
  ]
}

patch {
  url: {{BASE_URL}}/v0/credentials/:credential_id
  body: json
  auth: inherit
}

params:path {
  credential_id: 
}

body:json {
  {
    "credentialStatus": "INVALID"
  }
}

docs {
  Updates a credential's status according to the IETF OAuth Token Status List specification.
}

example {
  name: 204 Response
  description: Credential status updated successfully
  
  request: {
    url: {{BASE_URL}}/v0/credentials/:credential_id
    method: PATCH
    mode: json
    params:path: {
      credential_id: 
    }
  
    body:json: {
      {
        "credentialStatus": "INVALID"
      }
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

