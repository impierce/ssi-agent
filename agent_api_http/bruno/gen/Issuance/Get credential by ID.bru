meta {
  name: Get credential by ID
  type: http
  seq: 3
  tags: [
    Issuance
  ]
}

get {
  url: {{BASE_URL}}/v0/credentials/:credential_id
  body: none
  auth: inherit
}

params:path {
  credential_id: 
}

docs {
  Retrieves a credential by its ID.
}

example {
  name: 200 Response
  description: Successfully retrieved credential
  
  request: {
    url: {{BASE_URL}}/v0/credentials/:credential_id
    method: GET
    mode: none
    params:path: {
      credential_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "created_at": "",
          "credential_configuration": {
            "credential_format": "jwt_vc_json",
            "credential_metadata": {
              "claims": [],
              "display": [
                {
                  "background_color": "",
                  "background_image": "",
                  "description": "",
                  "locale": "",
                  "logo": {
                    "alt_text": "",
                    "uri": ""
                  },
                  "name": "",
                  "text_color": ""
                }
              ]
            },
            "credential_signing_alg_values_supported": [],
            "cryptographic_binding_methods_supported": [],
            "proof_types_supported": {},
            "scope": {}
          },
          "credential_status": {
            "index": 0,
            "status": "VALID",
            "status_list_url": ""
          },
          "data": "",
          "expires_at": "",
          "holder_notifications": [
            {
              "event": "credential_accepted",
              "event_description": "",
              "notification_id": ""
            }
          ],
          "id": "",
          "notification_id": "",
          "signed": "",
